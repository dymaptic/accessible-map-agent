# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/accessible_map_agent"

# ArcGIS OAuth
ARCGIS_CLIENT_ID="your-client-id"

# App URL (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Anthropic
ANTHROPIC_API_KEY="sk-ant-..."

# Session
SESSION_SECRET="generate-random-32-char-string"

# Admin usernames (comma-separated ArcGIS usernames)
ADMIN_USERNAMES="your_arcgis_username"

# Email (Brevo/Sendinblue)
BREVO_API_KEY="your-brevo-api-key"
ADMIN_NOTIFICATION_EMAILS="admin1@example.com,admin2@example.com"
EMAIL_FROM_ADDRESS="noreply@dymaptic.com"
EMAIL_FROM_NAME="Accessible Map Agent"

# Webhooks
WEBHOOK_URL="https://your-webhook-endpoint.com/webhook"
WEBHOOK_SECRET="generate-random-32-char-string"

# Cron Authentication
CRON_SECRET="generate-random-32-char-string"

# Environment (set to "production" to remove [TEST] prefix from emails)
APP_ENVIRONMENT="development"
